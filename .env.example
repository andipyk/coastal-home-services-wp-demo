# Copy to .env and fill in real values. .env is git-ignored.

# --- Database ---
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Ports: one block of ten per project (see compose.yaml) ---
WP_PORT=8090
PMA_PORT=8091

# --- WordPress site ---
WP_URL=http://localhost:8090
WP_TITLE="Coastal Home Services (Demo)"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=you@example.com

# --- Automation ---
# Outbound: WordPress POSTs each new lead here (Make.com/Zapier "Custom
# Webhook" trigger URL, or a https://webhook.site URL for local testing).
COASTAL_WEBHOOK_URL=

# Inbound: shared secret Make/Zapier must send back in the
# `x-webhook-secret` header when calling /wp-json/coastal/v1/lead-status.
# Generate with: openssl rand -hex 32
COASTAL_WEBHOOK_SECRET=change-me

# The callback address sent in each payload. Make.com cannot reach localhost,
# so set this to the tunnel URL, e.g.
#   https://<name>.trycloudflare.com/wp-json/coastal/v1/lead-status
# Empty falls back to rest_url(), which is only right for a local caller.
COASTAL_CALLBACK_URL=
